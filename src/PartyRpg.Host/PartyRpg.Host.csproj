<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <AnalysisLevel>latest</AnalysisLevel>
    <Deterministic>true</Deterministic>
    <AllowUnsafeBlocks>false</AllowUnsafeBlocks>
    <!-- The immutable SDK owns generated CoreCLR and NativeAOT composition below obj. This ordinary
         product project remains the one entry root, and the only project that declares a product. -->
    <RustyEngineProductEntryType>PartyRpg.Host.CrawlerProduct</RustyEngineProductEntryType>
    <RustyEngineProductId>rusty-crawler-partyrpg</RustyEngineProductId>
    <RustyEngineProductTitle>Rusty Crawler</RustyEngineProductTitle>
    <RustyEngineProductUiRoot>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)../ui/generated'))</RustyEngineProductUiRoot>
    <RustyEngineProductContentRoot>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)../../content'))</RustyEngineProductContentRoot>
    <RustyEngineProductUiEntry>main.js</RustyEngineProductUiEntry>
    <RustyEngineProductUiProjectionStream>crawler.hud</RustyEngineProductUiProjectionStream>
    <RustyEngineProductUiProjectionContract>crawler.ui.snapshot.v1</RustyEngineProductUiProjectionContract>
    <RustyEngineProductLifecycleMode>realtime</RustyEngineProductLifecycleMode>
    <RustyEngineProductFixedStepHz>60</RustyEngineProductFixedStepHz>
    <RustyEngineProductFixedStepMaxCatchUpSteps>4</RustyEngineProductFixedStepMaxCatchUpSteps>
    <RustyEngineWatchPaths>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)'));$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)../PartyRpg.Kit'));$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)../PartyRpg.Rulesets.MightAndMagic7'));$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)../ui'));$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)../../content'))</RustyEngineWatchPaths>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../PartyRpg.Kit/PartyRpg.Kit.csproj" />
    <ProjectReference Include="../PartyRpg.Rulesets.MightAndMagic7/PartyRpg.Rulesets.MightAndMagic7.csproj" />
    <PackageReference Include="Rusty.Engine" Version="$(RustyEnginePackageVersion)">
      <ExcludeAssets Condition="'$(RustyEngineUseSourceDevelopment)' == 'true'">compile;runtime</ExcludeAssets>
    </PackageReference>
    <!-- The one input intent that exists so far, plus the payload channel the DOM companion uses.
         Gameplay intents arrive with the stones that implement them, never as declarations first. -->
    <RustyEngineProductInputIntent Include="session.pause-toggle" Value="digital" />
    <RustyEngineProductInputMapping Include="session.pause-toggle.key-p" Intent="session.pause-toggle" Trigger="key:key-p:pressed" />
    <!-- First-person movement, one digital intent per action, declared here because the engine rejects a
         mapping whose intent the product never declared: a name that exists only in code is a control
         that silently does nothing. -->
    <RustyEngineProductInputIntent Include="party.move-forward" Value="digital" />
    <RustyEngineProductInputMapping Include="party.move-forward.key-w" Intent="party.move-forward" Trigger="key:key-w:held" />
    <RustyEngineProductInputIntent Include="party.move-back" Value="digital" />
    <RustyEngineProductInputMapping Include="party.move-back.key-s" Intent="party.move-back" Trigger="key:key-s:held" />
    <RustyEngineProductInputIntent Include="party.strafe-left" Value="digital" />
    <RustyEngineProductInputMapping Include="party.strafe-left.key-a" Intent="party.strafe-left" Trigger="key:key-a:held" />
    <RustyEngineProductInputIntent Include="party.strafe-right" Value="digital" />
    <RustyEngineProductInputMapping Include="party.strafe-right.key-d" Intent="party.strafe-right" Trigger="key:key-d:held" />
    <RustyEngineProductInputIntent Include="party.turn-left" Value="digital" />
    <RustyEngineProductInputMapping Include="party.turn-left.key-q" Intent="party.turn-left" Trigger="key:key-q:held" />
    <RustyEngineProductInputIntent Include="party.turn-right" Value="digital" />
    <RustyEngineProductInputMapping Include="party.turn-right.key-e" Intent="party.turn-right" Trigger="key:key-e:held" />
    <RustyEngineProductInputIntent Include="party.jump" Value="digital" />
    <!-- The engine names the space bar `space`; `key-space` is refused at load, and the product refuses to
         start on an unsupported mapping rather than starting with a control that does nothing. -->
    <RustyEngineProductInputMapping Include="party.jump.key-space" Intent="party.jump" Trigger="key:space:pressed" />
    <!-- The creation screen's two value-free controls: a keyboard can confirm the step being made and
         accept the finished party, while every choice that names a portrait, a class, a skill, an
         attribute, a member, or a name arrives as a payload action on the `crawler.ui` channel below.
         Both are read only while the session is creating a party; during play the same keys keep their
         movement meanings, and neither control is consulted. -->
    <RustyEngineProductInputIntent Include="creation.advance" Value="digital" />
    <RustyEngineProductInputMapping Include="creation.advance.key-enter" Intent="creation.advance" Trigger="key:enter:pressed" />
    <RustyEngineProductInputIntent Include="creation.accept" Value="digital" />
    <RustyEngineProductInputMapping Include="creation.accept.key-space" Intent="creation.accept" Trigger="key:space:pressed" />
    <!-- The save control. The engine's keyboard controls have no function keys, so a save is asked for with
         a letter: F, which is free during play and does not collide with a movement control. The engine
         refuses a mapping whose intent the product never declared, so this declaration and the code
         constant in ProductIdentity.cs are the two halves of the same control. -->
    <RustyEngineProductInputIntent Include="session.save" Value="digital" />
    <RustyEngineProductInputMapping Include="session.save.key-f" Intent="session.save" Trigger="key:key-f:pressed" />
    <RustyEngineProductInputIntent Include="crawler.ui" Value="payload:crawler.ui.action.v1" />
  </ItemGroup>

  <!-- TypeScript builds only the product-owned DOM companion. The runtime pack provides the browser
       shell, the renderer, and the transport. -->
  <Target Name="BuildCrawlerProductUi" BeforeTargets="GenerateRustyEngineProductComposition">
    <MakeDir Directories="$(RustyEngineProductUiRoot)" />
    <Exec Command="npm --prefix &quot;$(MSBuildThisFileDirectory)../..&quot; exec -- tsc --target ES2022 --module ES2022 --moduleResolution bundler --strict --noEmitOnError --outDir &quot;$(RustyEngineProductUiRoot)&quot; &quot;$(MSBuildThisFileDirectory)../ui/main.ts&quot;" />
  </Target>

  <ItemGroup>
    <!-- The host's suite exercises the composition seam the product keeps internal: the identity it
         declares, the bundles it ships, and the selection it makes. -->
    <InternalsVisibleTo Include="PartyRpg.Host.Tests" />
  </ItemGroup>
</Project>
